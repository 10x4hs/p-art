{
  "name": "part",
  "version": "1.0.0",
  "description": "PART — 학생 프로젝트 전시 서비스",
  "main": "backend/src/index.js",
  "scripts": {
    "dev": "npm run db:local && wrangler dev",
    "db:local": "wrangler d1 migrations apply p-art --local",
    "db:remote": "wrangler d1 migrations apply p-art --remote",
    "deploy": "npm run db:remote && wrangler deploy",
    "check": "node --check frontend/js/app.js && wrangler deploy --dry-run --outdir .wrangler/dry",
    "test": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
