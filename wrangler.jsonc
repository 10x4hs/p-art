{
  // PART — Cloudflare Workers 배포 설정 (docs/DEPLOY-CLOUDFLARE.md 참고)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p-art",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "build": { "command": "node scripts/build-cf.js" },
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "p-art", "database_id": "df14cf96-6d63-4752-b6e4-948a5d299880", "migrations_dir": "worker/migrations" }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "p-art-uploads" }
  ],
  "observability": { "enabled": true }
}
