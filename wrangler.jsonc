// Cloudflare Workers 설정 — `npm run dev`(내 컴퓨터) / `npm run deploy`(인터넷)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p-art",
  "main": "backend/src/index.js",
  "compatibility_date": "2025-09-01",

  // 화면 파일: frontend/ 폴더를 그대로 내보낸다.
  // 아래 주소들만 먼저 Worker(backend)가 처리하고, 나머지는 파일을 찾아 보낸다.
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*", "/shared/*"]
  },

  // DB: D1 (SQLite). id는 `npx wrangler d1 create p-art`로 만든 값 (비밀값 아님)
  "d1_databases": [
    { "binding": "DB", "database_name": "p-art", "database_id": "df14cf96-6d63-4752-b6e4-948a5d299880", "migrations_dir": "backend/migrations" }
  ],

  // 사진: KV. id는 `npx wrangler kv namespace create IMAGES`로 만든 값
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "c1393cb93bbf4331a9725ec25d4877c1" }
  ],

  "observability": { "enabled": true }
}
