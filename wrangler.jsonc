// [파일 개요] Cloudflare Workers 설정이에요. `npm run dev`(내 컴퓨터)와 `npm run deploy`(인터넷)가 둘 다 읽어요. JSONC라 주석을 쓸 수 있어요.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p-art",
  "main": "backend/src/index.js",
  // 이 날짜 기준 동작으로 고정해서, Cloudflare가 동작을 바꿔도 코드가 안 깨져요.
  "compatibility_date": "2025-09-01",

  // 화면 파일은 frontend/에서 바로 보내고, run_worker_first 주소만 Worker(backend)가 처리해요.
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*", "/shared/*"]
  },

  // DB(D1, SQLite) — 코드에서 c.env.DB로 써요. id는 비밀값이 아니에요.
  "d1_databases": [{ "binding": "DB", "database_name": "p-art", "database_id": "df14cf96-6d63-4752-b6e4-948a5d299880", "migrations_dir": "backend/migrations" }],

  // 사진 저장소(R2) — 코드에서 c.env.IMAGES로 써요. KV보다 파일 저장에 알맞아요.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "p-art-uploads" }],

  // 대시보드에서 로그(console.error)와 요청 기록을 볼 수 있게 켜요.
  "observability": { "enabled": true }
}
